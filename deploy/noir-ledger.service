[Unit]
Description=Noir Ledger Next.js service
After=network.target

[Service]
Type=simple
User=noirledger
Group=noirledger
WorkingDirectory=/opt/noirledger/current
Environment=NODE_ENV=production
Environment=HOSTNAME=0.0.0.0
Environment=PORT=3000
EnvironmentFile=/opt/noirledger/shared/.env
ExecStart=/usr/bin/npm run start -- --hostname 0.0.0.0 --port 3000
Restart=always
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
